<Project Sdk="Microsoft.NET.Sdk">
  <!-- One CLI, two builds: net10.0 (the Mac: test pattern only) and net10.0-windows
       (screen capture, Media Foundation, loopback sound, diag, selftest). -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>tylercast</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TylerCast.Core\TylerCast.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\TylerCast.Windows\TylerCast.Windows.csproj" />
  </ItemGroup>
</Project>
