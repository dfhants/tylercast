<UserControl x:Class="TylerCast.App.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TylerCast.App"
             Width="360" FontSize="14"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <!-- Laid out like Windows 11's Wi-Fi list: a header, the TVs as rows (the chosen one
       opens up with its options and button), and a footer with More settings. Colours and
       controls come from Windows' own Fluent theme (Application.ThemeMode), so light/dark
       and the accent colour follow the user's Windows settings. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Vis" />

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A flat button that shows a subtle fill on hover, like a row in the Wi-Fi list. -->
    <Style x:Key="Subtle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="20,16,20,14">
      <TextBlock Style="{StaticResource Glyph}" Text="&#xEC15;" FontSize="18" Margin="0,0,14,0" />
      <TextBlock Text="Cast" FontSize="16" VerticalAlignment="Center" />
    </DockPanel>

    <!-- The list -->
    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
      <StackPanel Margin="6">

        <!-- Network warning (Public network) -->
        <Border Visibility="{Binding HasWarning, Converter={StaticResource Vis}}" Margin="2,2,2,6" Padding="12,10"
                CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <DockPanel>
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,1,10,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <Button DockPanel.Dock="Right" Content="Fix" Click="Fix_Click" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="56" />
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="13" />
          </DockPanel>
        </Border>

        <!-- TVs -->
        <ItemsControl ItemsSource="{Binding Tvs}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Row" CornerRadius="4" Margin="0,1">
                <Grid>
                  <!-- The accent bar the Wi-Fi list puts beside the connected network. -->
                  <Border Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,14" Panel.ZIndex="1"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          Visibility="{Binding IsActive, Converter={StaticResource Vis}}" />
                  <StackPanel>
                    <Button Style="{StaticResource Subtle}" Click="Row_Click" Padding="14,10"
                            AutomationProperties.Name="{Binding Name}">
                      <DockPanel>
                        <TextBlock x:Name="TvGlyph" Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="20"
                                   VerticalAlignment="Top" Margin="0,2,14,0" />
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock x:Name="Sub" Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
                        </StackPanel>
                      </DockPanel>
                    </Button>

                    <!-- Opened, not casting: sound choices and Cast -->
                    <StackPanel Margin="48,0,14,12" Visibility="{Binding ShowCastOptions, Converter={StaticResource Vis}}">
                      <CheckBox Content="Sound on TV" IsChecked="{Binding Model.SoundOnTv}" />
                      <CheckBox Content="Mute this PC" IsChecked="{Binding Model.MuteThisPc}" IsEnabled="{Binding Model.SoundOnTv}" />
                      <Button Content="{Binding CastLabel}" Style="{DynamicResource AccentButtonStyle}" Click="Cast_Click"
                              HorizontalAlignment="Right" MinWidth="120" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Connecting -->
                    <StackPanel Margin="48,0,14,12" Visibility="{Binding ShowConnectingOptions, Converter={StaticResource Vis}}">
                      <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,8"
                                 Visibility="{Binding ShowFirewallNote, Converter={StaticResource Vis}}"
                                 Text="If Windows asks whether TylerCast can use the network, tick Private networks and click Allow." />
                      <Button Content="Cancel" Click="Disconnect_Click" HorizontalAlignment="Right" MinWidth="120" />
                    </StackPanel>

                    <!-- Casting: the margin (live) and Disconnect -->
                    <StackPanel Margin="48,0,14,12" Visibility="{Binding ShowCastingOptions, Converter={StaticResource Vis}}">
                      <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Fit to TV" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Model.MarginText}" Style="{StaticResource Secondary}"
                                   VerticalAlignment="Center" Width="30" TextAlignment="Right" />
                        <Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Model.Margin}" VerticalAlignment="Center"
                                AutomationProperties.Name="Fit to TV"
                                ToolTip="Shrinks the picture if the TV cuts off the edges" />
                      </DockPanel>
                      <TextBlock Text="{Binding Model.SoundSummary}" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
                      <Button Content="Disconnect" Click="Disconnect_Click" HorizontalAlignment="Right" MinWidth="120" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="TvGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                  <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- No TVs (yet) -->
        <DockPanel Margin="14,10" Visibility="{Binding NoTvs, Converter={StaticResource Vis}}">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="20" VerticalAlignment="Top" Margin="0,2,14,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <StackPanel>
            <TextBlock Text="{Binding EmptyTitle}" />
            <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Secondary}" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Footer -->
    <DockPanel Grid.Row="2" Margin="10,8,10,10">
      <Button DockPanel.Dock="Right" Style="{StaticResource Subtle}" Click="Refresh_Click" Width="36" Height="32"
              HorizontalContentAlignment="Center" ToolTip="Search for TVs again" AutomationProperties.Name="Search for TVs again"
              IsEnabled="{Binding Searching, Converter={x:Static local:Negate.Instance}}">
        <TextBlock Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <RotateTransform />
          </TextBlock.RenderTransform>
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Searching}" Value="True">
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Spin">
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360"
                                         Duration="0:0:1" RepeatBehavior="Forever" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Spin" />
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Button>
      <Button Style="{StaticResource Subtle}" Click="Settings_Click" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="10,7">
        <TextBlock Text="More settings" />
      </Button>
    </DockPanel>
  </Grid>
</UserControl>
