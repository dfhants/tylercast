<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tray app: a WPF flyout in the style of Windows 11's Wi-Fi list, over the
       same engine as the CLI. Builds on the Mac (EnableWindowsTargeting); runs on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon (WPF has no tray icon) and Screen. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TylerCast</AssemblyName>
    <RootNamespace>TylerCast.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Made from the Mac app's icon by tools/make-icon.py: one design for both. -->
    <ApplicationIcon>TylerCast.ico</ApplicationIcon>
    <!-- CA1416: version checked at start-up. WPF0001: ThemeMode (Windows 11 Fluent styles) is marked experimental. -->
    <NoWarn>$(NoWarn);CA1416;WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and Windows Forms both have Application, Button, ...: only WPF's are imported. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="TylerCast.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TylerCast.Core\TylerCast.Core.csproj" />
    <ProjectReference Include="..\TylerCast.Windows\TylerCast.Windows.csproj" />
  </ItemGroup>
</Project>
